#!/usr/bin/env bash
# dev/bump-node — refresh the base-image digest pin (NODE_IMAGE= in .env),
# the single source of truth for dev scripts AND the prod Dockerfile.
# Base-image updates become a reviewable one-line git diff.
source "$(dirname "$0")/_lib.sh"

TAG="${IMAGE%%@*}"          # e.g. node:24-slim
OLD_DIGEST="${IMAGE##*@}"

posture "🛰  bump-node" "tag: $TAG" "network: on (registry manifest only)"

NEW_DIGEST="$(docker buildx imagetools inspect "$TAG" --format '{{.Manifest.Digest}}')"
[ -n "$NEW_DIGEST" ] || die "could not fetch digest for $TAG (registry unreachable?)"

if [ "$NEW_DIGEST" = "$OLD_DIGEST" ]; then
  ok "already current — $TAG@$OLD_DIGEST (no-op)"
  exit 0
fi

sed -i.bak "s|^NODE_IMAGE=.*|NODE_IMAGE=$TAG@$NEW_DIGEST|" "$PIN_FILE" && rm -f "$PIN_FILE.bak"
say "   old: $OLD_DIGEST"
say "   new: $NEW_DIGEST"
ok "pin updated — dev scripts and Dockerfile now use the new digest (review the one-line diff, then ./dev/install)"
